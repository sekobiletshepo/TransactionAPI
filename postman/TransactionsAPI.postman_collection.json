{
  "info": {
    "_postman_id": "8016fc5b-1e3c-44ab-b081-43b1b8c5c6e1",
    "name": "TransactionsAPI - Local Demo",
    "description": "Requests for the locally running TransactionsAPI. Start the app with the local profile to load its H2 mock data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "localhost:8080"
    },
    {
      "key": "accountId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "from",
      "value": "2026-01-01"
    },
    {
      "key": "to",
      "value": "2026-01-31"
    }
  ],
  "item": [
    {
      "name": "Get category totals",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://{{baseUrl}}/api/v1/transactions/aggregates?from={{from}}&to={{to}}",
          "protocol": "http",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions",
            "aggregates"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns category totals', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.grandTotal).to.eql(483.49);",
              "    pm.expect(body.categories).to.have.lengthOf(4);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Filter by account and category",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://{{baseUrl}}/api/v1/transactions/aggregates?accountId={{accountId}}&categoryId={{categoryId}}&from={{from}}&to={{to}}",
          "protocol": "http",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions",
            "aggregates"
          ],
          "query": [
            {
              "key": "accountId",
              "value": "{{accountId}}"
            },
            {
              "key": "categoryId",
              "value": "{{categoryId}}"
            },
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns the selected category total', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.grandTotal).to.eql(125.5);",
              "    pm.expect(body.categories).to.have.lengthOf(1);",
              "    pm.expect(body.categories[0].categoryName).to.eql('Food');",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
